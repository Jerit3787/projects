<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.intro }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.intro }}">
  {% if ogImage %}<meta property="og:image" content="{{ site.url }}{{ ogImage }}">{% endif %}
  <script>try{var t=localStorage.getItem('theme');if(t==='dark'||t==='light')document.documentElement.dataset.theme=t}catch(e){}</script>
  <link rel="stylesheet" href="/styles/tokens.css">
  <link rel="stylesheet" href="/styles/base.css">
  <link rel="stylesheet" href="/styles/components.css">
  {% if pageStyles %}<link rel="stylesheet" href="/styles/{{ pageStyles }}">{% endif %}
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%230C66E4'/><text x='16' y='22' font-family='sans-serif' font-size='18' font-weight='700' fill='white' text-anchor='middle'>D</text></svg>">
</head>
<body>
  <header class="topnav">
    <div class="topnav__inner">
      <a class="topnav__brand" href="/"><span class="topnav__mark" aria-hidden="true">D</span><span class="topnav__label">{{ site.title }}</span></a>
      <nav class="topnav__links" aria-label="Main">
        {%- for item in site.nav %}
        <a href="{{ item.href }}"{% if item.href == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {%- endfor %}
      </nav>
      <button class="btn btn--subtle btn--icon theme-toggle" type="button" aria-label="Toggle theme">
        <span class="icon-sun" aria-hidden="true">☀</span><span class="icon-moon" aria-hidden="true">☾</span>
      </button>
    </div>
  </header>
  <main class="page" id="main">
    {{ content | safe }}
  </main>
  <footer class="footer">
    <div class="footer__inner">
      <span>© {{ site.author.name }}</span>
      <nav class="footer__links" aria-label="Elsewhere">
        {%- for l in site.author.links %}<a href="{{ l.href }}">{{ l.label }}</a>{% endfor -%}
      </nav>
    </div>
  </footer>
  <script type="module" src="/scripts/theme.js"></script>
  {% if pageScript %}<script type="module" src="/scripts/{{ pageScript }}"></script>{% endif %}
</body>
</html>
