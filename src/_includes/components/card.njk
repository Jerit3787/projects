{%- from "components/lozenge.njk" import lozenge -%}
{%- from "components/tag.njk" import tag -%}
{%- macro card(project, featured=false) -%}
{%- set tech = project.tech or [] -%}
<article class="card{% if featured %} card--featured{% endif %}"
  data-slug="{{ project.slug }}"
  data-category="{{ project.category }}"
  data-status="{{ project.status }}"
  data-tech="{{ tech | join('|') }}"
  data-search="{{ [project.title, project.tagline, tech | join(' '), (project.tags or []) | join(' ')] | join(' ') | lower }}">
  {%- if project.cover %}
  <img class="card__cover" src="/assets/projects/{{ project.slug }}/{{ project.cover }}" alt="" loading="lazy" decoding="async">
  {%- else %}
  <div class="card__cover card__cover--placeholder" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="1.5"/><path d="m21 16-5-5-9 9"/></svg>
  </div>
  {%- endif %}
  <div class="card__body">
    <div class="card__head">
      <h3 class="card__title"><a href="/projects/{{ project.slug }}/">{{ project.title }}</a></h3>
      {{ lozenge(project.status) }}
    </div>
    <p class="card__tagline">{{ project.tagline }}</p>
    <div class="card__meta">
      {%- if tech.length %}
      <ul class="tags" aria-label="Tech">
        {%- for t in tech | head(4) %}<li>{{ tag(t) }}</li>{% endfor -%}
        {%- if tech.length > 4 %}<li><span class="tag">+{{ tech.length - 4 }}</span></li>{% endif -%}
      </ul>
      {%- else %}<span></span>{% endif %}
      <time class="card__date" datetime="{{ project.date }}">{{ project.date | monthYear }}</time>
    </div>
  </div>
</article>
{%- endmacro -%}
