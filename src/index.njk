---
layout: layouts/base.njk
permalink: /index.html
pageStyles: home.css
pageScript: filter.js
---
{%- from "components/card.njk" import card -%}
{%- from "components/button.njk" import button -%}
{%- set featured = projects | selectattr('featured') | head(3) -%}
<section class="hero">
  <div class="hero__text">
    <p class="eyebrow">Showcase</p>
    <h1>{{ site.title }}</h1>
    <p class="hero__intro">{{ site.intro }}</p>
    <div class="btn-group">
      {%- for l in site.author.links %}{{ button(l.label, l.href, 'primary' if loop.first else 'default', true) }}{% endfor -%}
    </div>
  </div>
  <div class="hero__stats" aria-label="Summary">
    <div><strong>{{ projects.length }}</strong><span>projects</span></div>
    <div><strong>{{ projects | where('status', 'active') | length }}</strong><span>in progress</span></div>
    <div><strong>{{ projects | allTech | length }}</strong><span>technologies</span></div>
  </div>
</section>

{%- if featured.length %}
<section class="section" id="featured" aria-labelledby="featured-h">
  <div class="section__head"><h2 id="featured-h">Featured</h2></div>
  <div class="grid grid--featured">
    {%- for p in featured %}{{ card(p, true) }}{% endfor %}
  </div>
</section>
{%- endif %}

<section class="section" aria-labelledby="all-h">
  <div class="section__head">
    <h2 id="all-h">All projects</h2>
    <p id="result-count" aria-live="polite">{{ projects.length }} projects</p>
  </div>

  <form class="filters" id="filters" role="search" hidden>
    <label class="field field--search">
      <span class="visually-hidden">Search projects</span>
      <input type="search" name="q" placeholder="Search projects" autocomplete="off">
    </label>
    <label class="field">
      <span class="visually-hidden">Category</span>
      <select name="category">
        <option value="">All categories</option>
        {%- for c in site.categories %}<option value="{{ c.id }}">{{ c.label }}</option>{% endfor %}
      </select>
    </label>
    <label class="field">
      <span class="visually-hidden">Status</span>
      <select name="status">
        <option value="">Any status</option>
        <option value="active">In progress</option>
        <option value="completed">Completed</option>
        <option value="paused">Paused</option>
        <option value="archived">Archived</option>
        <option value="cancelled">Cancelled</option>
      </select>
    </label>
    <label class="field">
      <span class="visually-hidden">Technology</span>
      <select name="tech">
        <option value="">Any tech</option>
        {%- for t in projects | allTech %}<option value="{{ t }}">{{ t }}</option>{% endfor %}
      </select>
    </label>
  </form>

  <div class="groups" id="all">
    {%- for c in site.categories %}
    {%- set items = projects | where('category', c.id) %}
    {%- if items.length %}
    <section class="group" aria-labelledby="cat-{{ c.id }}">
      <div class="group__head">
        <h3 id="cat-{{ c.id }}">{{ c.label }} <span class="group__count">{{ items.length }}</span></h3>
        {% if c.description %}<p>{{ c.description }}</p>{% endif %}
      </div>
      <div class="grid">
        {%- for p in items %}{{ card(p) }}{% endfor %}
      </div>
    </section>
    {%- endif %}
    {%- endfor %}
  </div>

  <div class="empty-state" id="empty-state" hidden>
    <h3>No projects match</h3>
    <p class="subtle">Try a different search or clear the filters.</p>
    <button class="btn" type="button" id="clear-filters">Clear filters</button>
  </div>
</section>
